# Orbius Backend Environment Variables
GEMINI_API_KEY=your_gemini_api_key_here
PORT=8000

# Optional: Live Email Dispatch (Resend API or Gmail SMTP)
# If left unconfigured, Orbius seamlessly operates in Studio Dispatch Mode.
RESEND_API_KEY=your_resend_api_key_here
# GMAIL_USER=your_name@gmail.com
# GMAIL_APP_PASSWORD=your_16_char_app_password
